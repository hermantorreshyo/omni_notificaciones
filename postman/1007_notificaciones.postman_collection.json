            ],
            "url": {
              "raw": "{{base_url}}/notifications/rules/form-options",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notifications",
                "rules",
                "form-options"
              ]
            },
            "description": "Correr primero -- deja notification_type_id, rule_type_id y hierarchy_level_id listos para los siguientes requests. Incluye una verificacion de seguridad critica: el catalogo de rule_types nunca debe traer target_table."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "['notification_types','hierarchy_levels','rule_types'].forEach(k => {",
                  "    pm.test('trae ' + k, () => pm.expect(json.data).to.have.property(k));",
                  "});",
                  "pm.test('rule_types NUNCA expone target_table', () => {",
                  "    json.data.rule_types.forEach(rt => pm.expect(rt).to.not.have.property('target_table'));",
                  "});",
                  "if (json.data.notification_types.length > 0) { pm.environment.set('notification_type_id', json.data.notification_types[0].id); }",
                  "if (json.data.rule_types.length > 0) { pm.environment.set('rule_type_id', json.data.rule_types[0].id); }",
                  "if (json.data.hierarchy_levels.length > 0) { pm.environment.set('hierarchy_level_id', json.data.hierarchy_levels[0].id); }"
                ]
              }
            }
          ]
